[mysqld]
# ==============================================
# InnoDB Buffer Pool (critical for performance)
# ==============================================
# With 4GB container memory, allocate ~50% to buffer pool
innodb_buffer_pool_size = 2G
innodb_buffer_pool_instances = 2

# ==============================================
# Connection Settings
# ==============================================
# 5 Ontop containers x 10 pool size + margin
max_connections = 100
thread_cache_size = 16

# ==============================================
# Query/Join Performance
# ==============================================
# SPARQL->SQL often produces complex JOINs
join_buffer_size = 4M
sort_buffer_size = 4M
read_buffer_size = 2M
read_rnd_buffer_size = 2M

# Temp tables for complex queries
tmp_table_size = 64M
max_heap_table_size = 64M

# ==============================================
# InnoDB I/O & Logging
# ==============================================
# Faster recovery, acceptable for non-production
innodb_flush_log_at_trx_commit = 2
innodb_log_file_size = 256M
innodb_log_buffer_size = 16M

# ==============================================
# Timeouts for long-running SPARQL translations
# ==============================================
wait_timeout = 300
interactive_timeout = 300
net_read_timeout = 15
net_write_timeout = 15

# ==============================================
# Table Open Cache (SPARQL may touch many tables)
# ==============================================
table_open_cache = 2000
table_definition_cache = 1000
