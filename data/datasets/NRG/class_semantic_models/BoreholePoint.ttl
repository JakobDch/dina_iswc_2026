@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix eno: <http://example.org/ontology/energy#> .

eno:BoreholePoint eno:codeEW xsd:string ;
    eno:codeNS xsd:string ;
    eno:dateSynchronized xsd:date ;
    eno:decimalDegreesEW xsd:decimal ;
    eno:decimalDegreesNS xsd:decimal ;
    eno:degreesEW xsd:integer ;
    eno:degreesNS xsd:integer ;
    eno:geodeticDatum xsd:string ;
    eno:minutesEW xsd:integer ;
    eno:minutesNS xsd:integer ;
    eno:secondsEW xsd:decimal ;
    eno:secondsNS xsd:decimal ;
    eno:utmEW xsd:decimal ;
    eno:utmNS xsd:decimal ;
    eno:utmZone xsd:integer ;
    eno:coordinateForBorehole eno:WildcatBorehole ;
    eno:coordinateForBorehole eno:AppraisalBorehole ;
    eno:coordinateForBorehole eno:InitialBorehole ;
    eno:coordinateForBorehole eno:PlatformBorehole ;
    eno:coordinateForBorehole eno:ExplorationBorehole ;
    eno:coordinateForBorehole eno:Borehole ;
    eno:coordinateForBorehole eno:JunkedBorehole ;
    eno:coordinateForBorehole eno:SuspReenteredLaterBorehole ;
    eno:isGeometryOfFeature eno:WildcatBorehole ;
    eno:isGeometryOfFeature eno:AppraisalBorehole ;
    eno:isGeometryOfFeature eno:InitialBorehole ;
    eno:isGeometryOfFeature eno:PlatformBorehole ;
    eno:isGeometryOfFeature eno:ExplorationBorehole ;
    eno:isGeometryOfFeature eno:Borehole ;
    eno:isGeometryOfFeature eno:JunkedBorehole ;
    eno:isGeometryOfFeature eno:SuspReenteredLaterBorehole .