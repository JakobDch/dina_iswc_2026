@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix eno: <http://example.org/ontology/energy#> .

eno:ShallowBorehole eno:codeEW xsd:string ;
    eno:codeNS xsd:string ;
    eno:dateSynchronized xsd:date ;
    eno:dateUpdated xsd:date ;
    eno:dateUpdatedMax xsd:date ;
    eno:dateBoreholeCompletion xsd:date ;
    eno:dateBoreholeEntry xsd:date ;
    eno:decimalDegreesEW xsd:decimal ;
    eno:decimalDegreesNS xsd:decimal ;
    eno:degreesEW xsd:integer ;
    eno:degreesNS xsd:integer ;
    eno:designation xsd:string ;
    eno:drillPermit xsd:string ;
    eno:geodeticDatum xsd:string ;
    eno:minutesEW xsd:integer ;
    eno:minutesNS xsd:integer ;
    eno:registryId xsd:integer ;
    eno:secondsEW xsd:decimal ;
    eno:secondsNS xsd:decimal ;
    eno:totalDrillDepth xsd:decimal ;
    eno:utmEW xsd:decimal ;
    eno:utmNS xsd:decimal ;
    eno:utmZone xsd:integer ;
    eno:boreholeCompletionYear xsd:integer ;
    eno:boreholeEntryYear xsd:integer ;
    eno:boreholeNamePart1 xsd:integer ;
    eno:boreholeNamePart2 xsd:integer ;
    eno:boreholeNamePart3 xsd:string ;
    eno:boreholeNamePart4 xsd:integer ;
    eno:boreholeSeismicLocation xsd:string ;
    eno:boreholeWaterDepth xsd:decimal ;
    eno:shallowBoreholeForLicence eno:ExtractionPermit .