@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix eno: <http://example.org/ontology/energy#> .

eno:Deposit eno:condition xsd:string ;
    eno:dateSynchronized xsd:date ;
    eno:dateUpdated xsd:date ;
    eno:dateUpdatedMax xsd:date ;
    eno:designation xsd:string ;
    eno:registryId xsd:integer ;
    eno:activeDepositOperator eno:Company ;
    eno:currentDepositOwner eno:ExtractionPermit ;
    eno:discoveryBorehole eno:Borehole ;
    eno:discoveryBorehole eno:PlatformBorehole ;
    eno:discoveryBorehole eno:InitialBorehole ;
    eno:discoveryBorehole eno:WildcatBorehole .