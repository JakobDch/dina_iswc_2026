@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix eno: <http://example.org/ontology/energy#> .

eno:DepositReserve eno:dateResourceEstimate xsd:date ;
    eno:dateSynchronized xsd:date ;
    eno:recoverableCondensate xsd:decimal ;
    eno:recoverableGas xsd:decimal ;
    eno:recoverableNGL xsd:decimal ;
    eno:recoverableOil xsd:decimal ;
    eno:recoverableOilEquivalents xsd:decimal ;
    eno:registryId xsd:integer ;
    eno:remainingCondensate xsd:decimal ;
    eno:remainingGas xsd:decimal ;
    eno:remainingNGL xsd:decimal ;
    eno:remainingOil xsd:decimal ;
    eno:remainingOilEquivalents xsd:decimal ;
    eno:reservesForDeposit eno:Deposit .