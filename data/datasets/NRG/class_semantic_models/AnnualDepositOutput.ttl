@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix eno: <http://example.org/ontology/energy#> .

eno:AnnualDepositOutput eno:extractedCrude xsd:decimal ;
    eno:extractedGas xsd:decimal ;
    eno:outputYear xsd:integer ;
    eno:producedCondensate xsd:decimal ;
    eno:producedNGL xsd:decimal ;
    eno:producedOilEquivalents xsd:decimal ;
    eno:producedWater xsd:decimal ;
    eno:outputForDeposit eno:Deposit .