@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix eno: <http://example.org/ontology/energy#> .

eno:LithostratigraphicUnit eno:dateSynchronized xsd:date ;
    eno:designation xsd:string ;
    eno:registryId xsd:integer ;
    eno:stratigraphicLevel xsd:string ;
    eno:stratigraphicParent eno:LithostratigraphicUnit .