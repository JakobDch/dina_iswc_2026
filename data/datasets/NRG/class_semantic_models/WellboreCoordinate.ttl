@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix eno: <http://example.org/ontology/energy#> .

eno:WellboreCoordinate eno:codeEW xsd:string ;
    eno:codeNS xsd:string ;
    eno:dateSynchronized xsd:date ;
    eno:decimalDegreesEW xsd:decimal ;
    eno:decimalDegreesNS xsd:decimal ;
    eno:degreesEW xsd:integer ;
    eno:degreesNS xsd:integer ;
    eno:geodeticDatum xsd:string ;
    eno:minutesEW xsd:integer ;
    eno:minutesNS xsd:integer ;
    eno:secondsEW xsd:decimal ;
    eno:secondsNS xsd:decimal ;
    eno:utmEW xsd:decimal ;
    eno:utmNS xsd:decimal ;
    eno:utmZone xsd:integer ;
    eno:coordinateForWellbore eno:Borehole ;
    eno:coordinateForWellbore eno:InitialWellbore ;
    eno:coordinateForWellbore eno:PlatformBorehole ;
    eno:coordinateForWellbore eno:JunkedWellbore ;
    eno:coordinateForWellbore eno:AppraisalWellbore ;
    eno:coordinateForWellbore eno:ExplorationWellbore ;
    eno:coordinateForWellbore eno:WildcatWellbore ;
    eno:coordinateForWellbore eno:SuspReenteredLaterWellbore ;
    eno:isGeometryOfFeature eno:Borehole ;
    eno:isGeometryOfFeature eno:InitialWellbore ;
    eno:isGeometryOfFeature eno:PlatformBorehole ;
    eno:isGeometryOfFeature eno:JunkedWellbore ;
    eno:isGeometryOfFeature eno:AppraisalWellbore ;
    eno:isGeometryOfFeature eno:ExplorationWellbore ;
    eno:isGeometryOfFeature eno:WildcatWellbore ;
    eno:isGeometryOfFeature eno:SuspReenteredLaterWellbore .