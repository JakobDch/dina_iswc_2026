@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix eno: <http://example.org/ontology/energy#> .

eno:CondensatePipeline eno:currentCondition xsd:string ;
    eno:designation xsd:string ;
    eno:pipelineDimension xsd:decimal ;
    eno:pipelineMainGrouping xsd:string ;
    eno:pipelineMedium xsd:string ;
    eno:registryId xsd:integer ;
    eno:pipelineFromFacility eno:DeepConcrete3ShaftsFacility ;
    eno:pipelineFromFacility eno:Jacket4LegsFacility ;
    eno:pipelineToFacility eno:DeepConcrete4ShaftsFacility ;
    eno:pipelineToFacility eno:Jacket4LegsFacility .