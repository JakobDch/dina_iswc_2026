@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix eno: <http://example.org/ontology/energy#> .

eno:OilPipeline eno:currentStatus xsd:string ;
    eno:designation xsd:string ;
    eno:pipelineDimension xsd:decimal ;
    eno:pipelineMainGrouping xsd:string ;
    eno:pipelineMedium xsd:string ;
    eno:registryId xsd:integer ;
    eno:pipelineFromFacility eno:Jacket8LegsFacility ;
    eno:pipelineFromFacility eno:Jacket4LegsFacility ;
    eno:pipelineFromFacility eno:DeepConcrete4ShaftsFacility ;
    eno:pipelineFromFacility eno:Jacket6LegsFacility ;
    eno:pipelineToFacility eno:Jacket8LegsFacility ;
    eno:pipelineToFacility eno:FixedFacility .