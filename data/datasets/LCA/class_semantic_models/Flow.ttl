@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix oriont: <https://orienting.eu/oriont#> .
@prefix oriont-ext: <https://orienting.eu/oriont-ext#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

oriont:Flow oriont-ext:hasFlowName xsd:string ;
    oriont-ext:hasMeasureUnit xsd:string ;
    oriont-ext:hasMeasureValue xsd:decimal ;
    rdfs:label xsd:string ;
    oriont:hasEFCategorisation owl:Thing ;
    oriont:hasFlowClassification owl:Thing ;
    oriont:hasObjectType skos:ConceptScheme ;
    oriont:isInputOf skos:ConceptScheme ;
    oriont:isOutputOf skos:ConceptScheme .