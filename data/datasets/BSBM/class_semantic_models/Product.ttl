@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

bsbm:Product rdfs:comment xsd:string ;
    dc:date xsd:string ;
    rdfs:label xsd:string ;
    bsbm:productId xsd:string ;
    bsbm:productPropertyNumeric1 xsd:string ;
    bsbm:productPropertyNumeric2 xsd:string ;
    bsbm:productPropertyNumeric3 xsd:string ;
    bsbm:productPropertyNumeric4 xsd:string ;
    bsbm:productPropertyNumeric5 xsd:string ;
    bsbm:productPropertyNumeric6 xsd:string ;
    bsbm:productPropertyTextual1 xsd:string ;
    bsbm:productPropertyTextual2 xsd:string ;
    bsbm:productPropertyTextual3 xsd:string ;
    bsbm:productPropertyTextual4 xsd:string ;
    bsbm:productPropertyTextual5 xsd:string ;
    bsbm:productPropertyTextual6 xsd:string ;
    bsbm:producer bsbm:Producer ;
    bsbm:productFeature bsbm:ProductFeature ;
    dc:publisher bsbm:Producer ;
    bsbm:type bsbm:ProductType .