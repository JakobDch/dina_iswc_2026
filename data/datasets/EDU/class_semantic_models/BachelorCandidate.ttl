@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix eduo: <http://example.org/ontology/education#> .

eduo:BachelorCandidate eduo:emailAddress xsd:string ;
    eduo:label xsd:string ;
    eduo:telephone xsd:string ;
    eduo:belongsTo eduo:Division ;
    eduo:enrolledIn eduo:BasicModule ;
    eduo:mentor eduo:JuniorScholar ;
    eduo:mentor eduo:MidCareerScholar ;
    eduo:mentor eduo:SeniorScholar .