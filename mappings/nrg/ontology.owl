<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/ontology/energy#"
     xml:base="http://example.org/ontology/energy"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://example.org/ontology/energy"/>

    <!-- Classes -->
    <owl:Class rdf:about="http://example.org/ontology/energy#Borehole"/>
    <owl:Class rdf:about="http://example.org/ontology/energy#Well"/>
    <owl:Class rdf:about="http://example.org/ontology/energy#Deposit"/>
    <owl:Class rdf:about="http://example.org/ontology/energy#Facility"/>
    <owl:Class rdf:about="http://example.org/ontology/energy#Company"/>
    <owl:Class rdf:about="http://example.org/ontology/energy#ExtractionPermit"/>
    <owl:Class rdf:about="http://example.org/ontology/energy#Discovery"/>
    <owl:Class rdf:about="http://example.org/ontology/energy#Stratum"/>

    <!-- Datatype Properties -->
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/energy#designation"/>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/energy#condition"/>
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/energy#registryId"/>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="http://example.org/ontology/energy#belongsToWell"/>
    <owl:ObjectProperty rdf:about="http://example.org/ontology/energy#drillingFacility"/>
    <owl:ObjectProperty rdf:about="http://example.org/ontology/energy#wellOperator"/>

</rdf:RDF>
