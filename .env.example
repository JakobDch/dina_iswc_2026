# LLM API Keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
OPENROUTER_API_KEY=
HUGGINGFACE_API_TOKEN=

# Optional: Local LLM proxy (e.g. LiteLLM) used to route open-source models
# such as Qwen, Llama, etc. through an OpenAI-compatible endpoint.
LOCAL_PROXY_BASE_URL=http://localhost:4000/v1
LOCAL_PROXY_API_KEY=

# OnTop SPARQL Endpoint
ONTOP_SPARQL_URL=http://localhost:8080/sparql

# MySQL Database (for OnTop)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=experiment

# Embedding Settings
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Experiment Settings
DEFAULT_K_QUERIES=3
MAX_ITERATIONS=3
