# LLM API Keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# OnTop SPARQL Endpoint
ONTOP_SPARQL_URL=http://localhost:8080/sparql

# MySQL Database (for OnTop)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=experiment

# Embedding Settings
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Experiment Settings
DEFAULT_K_QUERIES=3
MAX_ITERATIONS=3

# Experiment switches used for the paper
# UNDER_INSTRUCTED=1 appends the underspecification rule to the agent prompts (Section 3.2 / RQ3).
UNDER_INSTRUCTED=0
